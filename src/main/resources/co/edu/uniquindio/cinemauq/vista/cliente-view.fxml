<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.cinemauq.controlador.ClienteController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="barra-superior">
            <Label text="CinemaUQ"/>
            <Label fx:id="lblBienvenida"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button onAction="#onCerrarSesion" text="Cerrar sesión"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <!-- ============ Cartelera y compra ============ -->
            <Tab text="Cartelera y compra">
                <HBox spacing="14.0">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/>
                    </padding>
                    <VBox prefWidth="290.0" spacing="8.0">
                        <Label styleClass="subtitulo" text="1. Películas en cartelera"/>
                        <ListView fx:id="lstPeliculas" prefHeight="220.0"/>
                        <Label fx:id="lblSinopsis" styleClass="ayuda" wrapText="true"/>
                        <Label styleClass="subtitulo" text="2. Funciones"/>
                        <ListView fx:id="lstFunciones" VBox.vgrow="ALWAYS"/>
                    </VBox>
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="subtitulo" text="3. Elija sus sillas"/>
                        <Label styleClass="ayuda" text="Gris: general · Dorado: preferencial (+30 %) · Verde: elegida · Rojo: vendida"/>
                        <Label maxWidth="Infinity" styleClass="pantalla-cine" text="PANTALLA"/>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <GridPane fx:id="gridAsientos" hgap="4.0" vgap="4.0">
                                <padding>
                                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
                                </padding>
                            </GridPane>
                        </ScrollPane>
                        <CheckBox fx:id="chkEntradasConPuntos" text="Pagar las entradas elegidas con puntos"/>
                    </VBox>
                    <VBox prefWidth="330.0" spacing="8.0">
                        <Label styleClass="subtitulo" text="4. Confitería"/>
                        <ComboBox fx:id="cmbConfiteria" maxWidth="Infinity" promptText="Producto o combo"/>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Spinner fx:id="spnCantidad" prefWidth="80.0"/>
                            <CheckBox fx:id="chkConfiteriaConPuntos" text="Con puntos"/>
                            <Button onAction="#onAgregarConfiteria" text="Agregar"/>
                        </HBox>
                        <Label styleClass="subtitulo" text="5. Resumen de la compra"/>
                        <ListView fx:id="lstResumen" VBox.vgrow="ALWAYS"/>
                        <Label fx:id="lblTotal" styleClass="total" wrapText="true"/>
                        <HBox spacing="8.0">
                            <Button onAction="#onComprar" styleClass="boton-principal" text="Comprar y pagar con mi tarjeta"/>
                            <Button onAction="#onLimpiarCompra" text="Limpiar"/>
                        </HBox>
                    </VBox>
                </HBox>
            </Tab>
            <!-- ============ Tarjeta ============ -->
            <Tab text="Mi tarjeta">
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/>
                    </padding>
                    <Label fx:id="lblTarjeta" styleClass="subtitulo"/>
                    <Label fx:id="lblSaldo" styleClass="titulo"/>
                    <Label styleClass="subtitulo" text="Movimientos (más recientes primero)"/>
                    <ListView fx:id="lstMovimientos" VBox.vgrow="ALWAYS"/>
                    <Label styleClass="subtitulo" text="¿Necesita saldo? Solicite una recarga (la aprueba un administrador)"/>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <TextField fx:id="txtValorRecarga" prefWidth="180.0" promptText="Valor, ej. 50000"/>
                        <Button onAction="#onSolicitarRecarga" text="Solicitar recarga"/>
                    </HBox>
                    <ListView fx:id="lstSolicitudes" prefHeight="110.0"/>
                </VBox>
            </Tab>
            <!-- ============ Compras ============ -->
            <Tab text="Mis compras">
                <HBox spacing="12.0">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/>
                    </padding>
                    <ListView fx:id="lstCompras" HBox.hgrow="ALWAYS"/>
                    <VBox prefWidth="420.0" spacing="8.0">
                        <Label styleClass="subtitulo" text="Detalle"/>
                        <TextArea fx:id="txtDetalleCompra" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
                        <Button onAction="#onCancelarCompra" text="Cancelar compra seleccionada"/>
                        <Label styleClass="ayuda" wrapText="true"
                               text="Más de 24 h antes: 100 % · entre 2 y 24 h: 80 % · menos de 2 h: no se permite. El dinero vuelve a su tarjeta."/>
                    </VBox>
                </HBox>
            </Tab>
            <!-- ============ Puntos ============ -->
            <Tab text="Mis puntos">
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/>
                    </padding>
                    <Label fx:id="lblPuntos" styleClass="titulo"/>
                    <Label fx:id="lblPorVencer" styleClass="subtitulo"/>
                    <Label fx:id="lblEquivalencia" styleClass="ayuda" wrapText="true"/>
                    <Label styleClass="subtitulo" text="Lotes de puntos (se redimen primero los que vencen antes)"/>
                    <ListView fx:id="lstAcumulaciones" VBox.vgrow="ALWAYS"/>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
