<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="560.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.edu.uniquindio.cinemauq.controlador.LoginController">
    <VBox maxWidth="380.0" spacing="12.0" styleClass="tarjeta-login" StackPane.alignment="CENTER">
        <Label styleClass="titulo" text="CinemaUQ"/>
        <Label styleClass="ayuda" text="Cartelera, entradas y confitería en un solo lugar."/>
        <Label text="Correo"/>
        <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com"/>
        <Label text="Contraseña"/>
        <PasswordField fx:id="txtContrasena" onAction="#onIngresar" promptText="Contraseña"/>
        <Button defaultButton="true" maxWidth="Infinity" onAction="#onIngresar" styleClass="boton-principal" text="Ingresar"/>
        <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true"/>
        <Hyperlink onAction="#onIrARegistro" text="¿No tiene cuenta? Regístrese"/>
        <Label styleClass="ayuda" wrapText="true"
               text="Usuarios de prueba: admin@cinemauq.com / admin123 · laura@correo.com / 123456 · carlos@correo.com / 123456 · sofia@correo.com / 123456 (tarjeta bloqueada)"/>
        <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="28.0"/>
        </padding>
    </VBox>
</StackPane>
