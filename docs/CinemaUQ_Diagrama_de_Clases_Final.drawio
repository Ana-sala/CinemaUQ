<mxCell id="p0_n1" value="Identificable también la implementan:&lt;br&gt;Pelicula, Sala, Funcion, Entrada, Compra,&lt;br&gt;Reembolso, Movimiento, SolicitudRecarga,&lt;br&gt;Promocion e ItemConfiteria." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8dc;strokeColor=#8a7a3a;fontSize=10;" vertex="1" parent="1">
