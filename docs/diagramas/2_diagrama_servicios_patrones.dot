digraph G {
graph [fontname="Helvetica", fontsize=20, labelloc=t, label="CinemaUQ · Servicios, contratos y patrones creacionales (MVC)", rankdir=TB, nodesep=0.4, ranksep=0.75, splines=ortho, newrank=true, pad=0.4];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#3b4252"];
ClienteController [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«controller»</FONT><BR/><B>ClienteController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-cartelera: ConsultaCartelera</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-construirCompra(): CompraBuilder<BR/>-onComprar(): void<BR/>-onCancelarCompra(): void</TD></TR></TABLE>>];
AdminController [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«controller»</FONT><BR/><B>AdminController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-cartelera: GestionCartelera</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-onRecargar(): void<BR/>-onProgramarFuncion(): void<BR/>-onDuplicarFuncion(): void<BR/>-onCancelarFuncion(): void</TD></TR></TABLE>>];
CinemaUQ [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><FONT POINT-SIZE="9">«Singleton»</FONT><BR/><B>CinemaUQ</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-instancia: CinemaUQ</U><BR/>-sesion: Sesion</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-CinemaUQ()<BR/><U>+getInstance(): CinemaUQ</U><BR/>+getCompras(): ServicioCompras<BR/>+getCartelera(): ServicioCartelera<BR/>+getTarjetas(): ServicioTarjeta<BR/>...</TD></TR></TABLE>>];
Sesion [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Sesion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-usuario: Usuario</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+iniciar(u: Usuario): void<BR/>+cerrar(): void</TD></TR></TABLE>>];
ConsultaCartelera [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>ConsultaCartelera</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+peliculasEnCartelera(): List&lt;Pelicula&gt;</I><BR/><I>+funcionesDisponibles(p): List&lt;Funcion&gt;</I></TD></TR></TABLE>>];
GestionCartelera [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>GestionCartelera</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+registrarPelicula(...): Pelicula</I><BR/><I>+registrarSala(...): Sala</I><BR/><I>+programarFuncion(...): Funcion</I><BR/><I>+duplicarFuncion(f, fecha): Funcion</I></TD></TR></TABLE>>];
ServicioCartelera [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>ServicioCartelera</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+MINUTOS_LIMPIEZA: int = 20</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-seCruzan(a, b): boolean</TD></TR></TABLE>>];
ServicioCompras [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>ServicioCompras</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+nuevaCompra(c, f): CompraBuilder<BR/>+pagar(c: Compra): Compra<BR/>+cancelarCompra(c, compra): Reembolso<BR/>+cancelarFuncion(admin, f): List&lt;Reembolso&gt;<BR/>-reembolsar(c, %, motivo): Reembolso</TD></TR></TABLE>>];
ServicioTarjeta [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>ServicioTarjeta</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+RECARGA_MINIMA = 10.000<BR/>+RECARGA_MAXIMA = 500.000</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+recargar(admin, c, valor): Movimiento<BR/>+solicitarRecarga(c, valor)<BR/>+aprobarSolicitud(admin, s)<BR/>+bloquearTarjeta(admin, c)</TD></TR></TABLE>>];
ServicioAutenticacion [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>ServicioAutenticacion</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+registrarCliente(...): Cliente<BR/>+iniciarSesion(correo, clave): Usuario</TD></TR></TABLE>>];
ServicioOtros [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>ServicioConfiteria · ServicioPuntos · ServicioEstadisticas</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">productos, combos y promociones<BR/>consulta de puntos<BR/>ventas, ocupación, más vendidos</TD></TR></TABLE>>];
Regla [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>ReglaAcumulacionPuntos</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+calcularPuntos(valor: double): int</I></TD></TR></TABLE>>];
ReglaValor [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>ReglaPorValorGastado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-pesosPorPunto: double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+calcularPuntos(valor): int</TD></TR></TABLE>>];
Equivalencia [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>EquivalenciaPuntos</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-pesosPorPunto: double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+puntosPara(precio): int</TD></TR></TABLE>>];
Politica [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>PoliticaCancelacion</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+porcentajeReembolso(inicio, ahora): int</TD></TR></TABLE>>];
Reloj [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Reloj</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ahora(): LocalDateTime</I></TD></TR></TABLE>>];
RelojSistema [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>RelojSistema</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ahora(): LocalDateTime</TD></TR></TABLE>>];
Repositorio [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Repositorio&lt;T extends Identificable&gt;</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+guardar(e: T): void</I><BR/><I>+buscarPorId(id): Optional&lt;T&gt;</I><BR/><I>+listar(): List&lt;T&gt;</I><BR/><I>+buscar(criterio): List&lt;T&gt;</I></TD></TR></TABLE>>];
RepoMem [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>RepositorioMemoria&lt;T&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-datos: Map&lt;String, T&gt;</TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
Catalogo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><B>CatalogoFabricasEntrada</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fabricas: Map&lt;TipoAsiento, FabricaEntrada&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+registrar(tipo, fabrica): void<BR/>+emitir(f, a): Entrada</TD></TR></TABLE>>];
FabricaEntrada [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><FONT POINT-SIZE="9">«Factory Method · Creator»</FONT><BR/><I><B>FabricaEntrada</B></I></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+emitir(f: Funcion, a: Asiento): Entrada<BR/><I>#crearEntrada(id, f, a): Entrada</I></TD></TR></TABLE>>];
FabGen [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><B>FabricaEntradaGeneral</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#crearEntrada(id, f, a): Entrada</TD></TR></TABLE>>];
FabPref [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><B>FabricaEntradaPreferencial</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#crearEntrada(id, f, a): Entrada</TD></TR></TABLE>>];
Builder [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><FONT POINT-SIZE="9">«Builder»</FONT><BR/><B>CompraBuilder</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+MAX_ENTRADAS: int = 10</U><BR/>-entradas: List&lt;Entrada&gt;<BR/>-lineas: List&lt;LineaConfiteria&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+agregarEntrada(a): CompraBuilder<BR/>+agregarEntradaConPuntos(a): CompraBuilder<BR/>+agregarConfiteria(item, n): CompraBuilder<BR/>+getPuntosNecesarios(): int<BR/>+build(): Compra</TD></TR></TABLE>>];
Compra [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Compra</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(ver diagrama del dominio)</TD></TR></TABLE>>];
Entrada [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><I><B>Entrada</B></I></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(ver diagrama del dominio)</TD></TR></TABLE>>];
ClienteController -> CinemaUQ [arrowhead=vee, style=dashed, xlabel="getInstance()"];
AdminController -> CinemaUQ [arrowhead=vee, style=dashed, xlabel="getInstance()"];
ClienteController -> ConsultaCartelera [arrowhead=vee, style=dashed, xlabel=""];
AdminController -> GestionCartelera [arrowhead=vee, style=dashed, xlabel=""];
CinemaUQ -> Sesion [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1", taillabel="1", xlabel="", labeldistance=1.6];
CinemaUQ -> ServicioCompras [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1", taillabel="1", xlabel="", labeldistance=1.6];
CinemaUQ -> ServicioCartelera [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1", taillabel="1", xlabel="", labeldistance=1.6];
CinemaUQ -> ServicioTarjeta [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1", taillabel="1", xlabel="", labeldistance=1.6];
CinemaUQ -> ServicioAutenticacion [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1", taillabel="1", xlabel="", labeldistance=1.6];
CinemaUQ -> ServicioOtros [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1", taillabel="1", xlabel="", labeldistance=1.6];
ConsultaCartelera -> ServicioCartelera [dir=back, arrowtail=onormal, style=dashed, arrowsize=1.3];
GestionCartelera -> ServicioCartelera [dir=back, arrowtail=onormal, style=dashed, arrowsize=1.3];
ServicioCompras -> Regla [arrowhead=vee, headlabel="1", taillabel="", xlabel="", labeldistance=1.6];
ServicioCompras -> Politica [arrowhead=vee, headlabel="1", taillabel="", xlabel="", labeldistance=1.6];
ServicioCompras -> Equivalencia [arrowhead=vee, headlabel="1", taillabel="", xlabel="", labeldistance=1.6];
ServicioCompras -> Catalogo [arrowhead=vee, headlabel="1", taillabel="", xlabel="", labeldistance=1.6];
ServicioCompras -> Repositorio [arrowhead=vee, headlabel="1", taillabel="", xlabel="compras", labeldistance=1.6];
ServicioCompras -> Reloj [arrowhead=vee, headlabel="1", taillabel="", xlabel="", labeldistance=1.6];
ServicioCartelera -> Repositorio [arrowhead=vee, headlabel="3", taillabel="", xlabel="películas, salas, funciones", labeldistance=1.6];
ServicioCartelera -> Reloj [arrowhead=vee, headlabel="1", taillabel="", xlabel="", labeldistance=1.6];
ServicioCompras -> Builder [arrowhead=vee, style=dashed, xlabel="«create»"];
Regla -> ReglaValor [dir=back, arrowtail=onormal, style=dashed, arrowsize=1.3];
Reloj -> RelojSistema [dir=back, arrowtail=onormal, style=dashed, arrowsize=1.3];
Repositorio -> RepoMem [dir=back, arrowtail=onormal, style=dashed, arrowsize=1.3];
Catalogo -> FabricaEntrada [dir=both, arrowtail=odiamond, arrowhead=none, headlabel="1..*", taillabel="", xlabel="", labeldistance=1.6];
FabricaEntrada -> FabGen [dir=back, arrowtail=onormal, arrowsize=1.3];
FabricaEntrada -> FabPref [dir=back, arrowtail=onormal, arrowsize=1.3];
Builder -> Catalogo [arrowhead=vee, headlabel="1", taillabel="", xlabel="", labeldistance=1.6];
Builder -> Equivalencia [arrowhead=vee, headlabel="1", taillabel="", xlabel="", labeldistance=1.6];
Builder -> Compra [arrowhead=vee, style=dashed, xlabel="«create» build()"];
FabricaEntrada -> Entrada [arrowhead=vee, style=dashed, xlabel="«create»"];
nd [shape=note, style=filled, fillcolor="#fff8dc", fontsize=9, label="DIP: los servicios reciben por el constructor\ninterfaces (Repositorio, Reloj, ReglaAcumulacionPuntos);\nCinemaUQ decide qué implementación usar."];
nd -> ServicioCompras [style=dotted, arrowhead=none];
}