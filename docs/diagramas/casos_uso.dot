digraph CU {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, label="CinemaUQ · Diagrama de casos de uso (entrega 1)", labelloc=t, nodesep=0.25, ranksep=1.3, pad=0.4];
  node [fontname="Helvetica", fontsize=11];
  edge [arrowhead=none, color="#3b4252"];
  visitante [shape=none, label="🧍\nVisitante", fontsize=13];
  cliente [shape=none, label="🧍\nCliente", fontsize=13];
  admin [shape=none, label="🧍\nAdministrador", fontsize=13];
  subgraph cluster_sistema {
    label="Sistema CinemaUQ"; fontsize=14; style=rounded; color="#1f2a44";
    node [shape=ellipse, style=filled, fillcolor="#e8f0fe", color="#1f2a44"];
    cu1 [label="CU-01 Registrarse"];
    cu2 [label="CU-02 Iniciar sesión"];
    cu3 [label="CU-03 Comprar entradas\ny confitería"];
    sel [label="Seleccionar sillas\nen el mapa"];
    pag [label="Pagar con\ntarjeta virtual"];
    red [label="Redimir puntos"];
    cu4 [label="CU-04 Cancelar compra"];
    cu5 [label="CU-05 Solicitar / aprobar\nrecarga"];
    cu8 [label="CU-08 Consultar puntos"];
    cu6 [label="CU-06 Programar o\nduplicar función"];
    cu7 [label="CU-07 Cancelar función"];
    est [label="Consultar estadísticas"];
    gest [label="Gestionar películas,\nsalas y confitería"];
  }
  visitante -> cu1; visitante -> cu2;
  cliente -> cu2; cliente -> cu3; cliente -> cu4; cliente -> cu5; cliente -> cu8;
  admin -> cu2; admin -> cu5; admin -> cu6; admin -> cu7; admin -> est; admin -> gest;
  edge [style=dashed, arrowhead=vee, fontsize=9, fontname="Helvetica"];
  cu3 -> sel [label="«include»"]; cu3 -> pag [label="«include»"]; red -> cu3 [label="«extend»"];
}
