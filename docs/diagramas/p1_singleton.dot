AdminController [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>AdminController</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
DatosIniciales [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>DatosIniciales</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+cargar(cine: CinemaUQ)</U></TD></TR></TABLE>>];
LoginController -> CinemaUQ [arrowhead=vee, style=dashed, xlabel="getInstance()"];
