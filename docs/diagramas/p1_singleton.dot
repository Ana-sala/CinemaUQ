edge [fontname="Helvetica", fontsize=9, color="#3b4252"];
CinemaUQ [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><FONT POINT-SIZE="9">«Singleton»</FONT><BR/><B>CinemaUQ</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-instancia: CinemaUQ</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-CinemaUQ()<BR/><U>+getInstance(): CinemaUQ</U><BR/>+getCompras(): ServicioCompras<BR/>+getSesion(): Sesion</TD></TR></TABLE>>];
