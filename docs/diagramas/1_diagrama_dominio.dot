digraph G {
graph [fontname="Helvetica", fontsize=20, labelloc=t, label="CinemaUQ · Diagrama de clases del dominio (paquete modelo)", rankdir=TB, nodesep=0.35, ranksep=0.6, splines=ortho, newrank=true, pad=0.4];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#3b4252"];
Identificable [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Identificable</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+getId(): String</I></TD></TR></TABLE>>];
Usuario [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><I><B>Usuario</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: String<BR/>-nombre: String<BR/>-correo: String<BR/>-contrasena: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+getRol(): Rol</I><BR/>+verificarContrasena(intento: String): boolean</TD></TR></TABLE>>];
Cliente [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Cliente</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-documento: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+agregarCompra(c: Compra): void<BR/>+getTarjeta(): TarjetaVirtual<BR/>+getCuentaPuntos(): CuentaPuntos</TD></TR></TABLE>>];
Administrador [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Administrador</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getRol(): Rol</TD></TR></TABLE>>];
TarjetaVirtual [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>TarjetaVirtual</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-numero: String<BR/>-saldo: double<BR/>-estado: EstadoTarjeta</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+validarPago(valor: double): void<BR/>+debitar(valor, desc, fecha): Movimiento<BR/>+acreditar(tipo, valor, desc, fecha): Movimiento<BR/>+bloquear(): void<BR/>+activar(): void</TD></TR></TABLE>>];
Movimiento [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Movimiento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: String<BR/>-fecha: LocalDateTime<BR/>-tipo: TipoMovimiento<BR/>-valor: double<BR/>-descripcion: String<BR/>-saldoResultante: double</TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
CuentaPuntos [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>CuentaPuntos</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+acumular(puntos, fecha, origen): void<BR/>+getDisponibles(hoy): int<BR/>+getPorVencer(hoy, dias): int<BR/>+redimir(puntos, hoy): void<BR/>+anularAcumulacion(origen): int</TD></TR></TABLE>>];
AcumulacionPuntos [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>AcumulacionPuntos</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-puntosObtenidos: int<BR/>-puntosDisponibles: int<BR/>-fechaObtencion: LocalDate<BR/>-fechaVencimiento: LocalDate<BR/>-origen: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+estaVigente(hoy: LocalDate): boolean</TD></TR></TABLE>>];
SolicitudRecarga [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>SolicitudRecarga</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: String<BR/>-valor: double<BR/>-fecha: LocalDateTime<BR/>-estado: EstadoSolicitud</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+aprobar(): void<BR/>+rechazar(): void</TD></TR></TABLE>>];
Pelicula [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Pelicula</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: String<BR/>-titulo: String<BR/>-genero: Genero<BR/>-clasificacion: Clasificacion<BR/>-duracionMinutos: int<BR/>-sinopsis: String<BR/>-enCartelera: boolean</TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
Sala [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Sala</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: String<BR/>-nombre: String<BR/>-tipo: TipoSala<BR/>-filas: int<BR/>-asientosPorFila: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+buscarAsiento(codigo): Optional&lt;Asiento&gt;<BR/>+getCapacidad(): int</TD></TR></TABLE>>];
Asiento [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Asiento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fila: char<BR/>-numero: int<BR/>-tipo: TipoAsiento</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getCodigo(): String</TD></TR></TABLE>>];
Prototipo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Prototipo&lt;T&gt;</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+clonar(): T</I></TD></TR></TABLE>>];
Funcion [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><B>Funcion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: String<BR/>-fechaHora: LocalDateTime<BR/>-precioBase: double<BR/>-estado: EstadoFuncion</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+clonar(): Funcion<BR/>+clonarPara(fecha): Funcion<BR/>+estaDisponible(a: Asiento): boolean<BR/>+ocupar(a: Asiento): void<BR/>+liberar(a: Asiento): void<BR/>+admiteVentas(ahora): boolean<BR/>+cancelar(): void</TD></TR></TABLE>>];
Entrada [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><I><B>Entrada</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: String<BR/>-pagadaConPuntos: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+getPrecio(): double</I><BR/><I>+getTipo(): TipoAsiento</I></TD></TR></TABLE>>];
EntradaGeneral [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><B>EntradaGeneral</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getPrecio(): double</TD></TR></TABLE>>];
EntradaPreferencial [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><B>EntradaPreferencial</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+RECARGO: double = 0.30</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getPrecio(): double</TD></TR></TABLE>>];
ItemConfiteria [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>ItemConfiteria</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+getNombre(): String</I><BR/><I>+getPrecio(): double</I><BR/><I>+isDisponible(): boolean</I></TD></TR></TABLE>>];
Producto [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Producto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: String<BR/>-nombre: String<BR/>-precio: double<BR/>-categoria: CategoriaProducto<BR/>-disponible: boolean</TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
Combo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Combo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: String<BR/>-nombre: String<BR/>-porcentajeDescuento: double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+agregarProducto(p: Producto): void<BR/>+getPrecio(): double</TD></TR></TABLE>>];
LineaConfiteria [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>LineaConfiteria</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-cantidad: int<BR/>-precioUnitario: double<BR/>-pagadaConPuntos: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getSubtotal(): double</TD></TR></TABLE>>];
Compra [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><B>Compra</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: String<BR/>-fecha: LocalDateTime<BR/>-estado: EstadoCompra<BR/>-valorPagado: double<BR/>-puntosRedimidos: int<BR/>-puntosGanados: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getTotalBruto(): double<BR/>+getValorAPagar(): double<BR/>+marcarPagada(fecha, valor, puntos): void<BR/>+registrarReembolso(r: Reembolso): void</TD></TR></TABLE>>];
Reembolso [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Reembolso</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: String<BR/>-fecha: LocalDateTime<BR/>-porcentaje: int<BR/>-valor: double<BR/>-puntosDevueltos: int<BR/>-motivo: MotivoReembolso</TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
Promocion [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Promocion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: String<BR/>-nombre: String<BR/>-porcentajeDescuento: double<BR/>-fechaInicio: LocalDate<BR/>-fechaFin: LocalDate<BR/>-activa: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+estaVigente(hoy): boolean</TD></TR></TABLE>>];
Enums [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8a93a6"><TR><TD COLSPAN="3" BGCOLOR="#f3f4f6"><B>Enumeraciones (modelo.enums)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>Rol</B><BR/>CLIENTE, ADMINISTRADOR</TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>EstadoTarjeta</B><BR/>ACTIVA, BLOQUEADA</TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>TipoMovimiento</B><BR/>PAGO, RECARGA, REEMBOLSO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>EstadoSolicitud</B><BR/>PENDIENTE, APROBADA, RECHAZADA</TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>Genero</B><BR/>ACCION, ANIMACION, COMEDIA, DRAMA,<BR/>TERROR, CIENCIA_FICCION, ...</TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>Clasificacion</B><BR/>TODO_PUBLICO, MAYORES_7, ..., MAYORES_18</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>TipoSala</B><BR/>DOS_D, TRES_D, VIP</TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>TipoAsiento</B><BR/>GENERAL, PREFERENCIAL</TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>EstadoFuncion</B><BR/>PROGRAMADA, CANCELADA</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>EstadoCompra</B><BR/>PENDIENTE, PAGADA, CANCELADA</TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>MotivoReembolso</B><BR/>CANCELACION_CLIENTE,<BR/>FUNCION_CANCELADA</TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>CategoriaProducto</B><BR/>CRISPETAS, BEBIDA, SNACK, DULCE</TD></TR></TABLE>>];
Usuario -> Cliente [dir=back, arrowtail=onormal, arrowsize=1.3];
Usuario -> Administrador [dir=back, arrowtail=onormal, arrowsize=1.3];
Entrada -> EntradaGeneral [dir=back, arrowtail=onormal, arrowsize=1.3];
Entrada -> EntradaPreferencial [dir=back, arrowtail=onormal, arrowsize=1.3];
ItemConfiteria -> Producto [dir=back, arrowtail=onormal, style=dashed, arrowsize=1.3];
ItemConfiteria -> Combo [dir=back, arrowtail=onormal, style=dashed, arrowsize=1.3];
Prototipo -> Funcion [dir=back, arrowtail=onormal, style=dashed, arrowsize=1.3];
Identificable -> Usuario [dir=back, arrowtail=onormal, style=dashed, arrowsize=1.3];
Cliente -> TarjetaVirtual [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1", taillabel="1", xlabel="", labeldistance=1.6];
Cliente -> CuentaPuntos [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1", taillabel="1", xlabel="", labeldistance=1.6];
TarjetaVirtual -> Movimiento [dir=both, arrowtail=diamond, arrowhead=none, headlabel="0..*", taillabel="1", xlabel="", labeldistance=1.6];
CuentaPuntos -> AcumulacionPuntos [dir=both, arrowtail=diamond, arrowhead=none, headlabel="0..*", taillabel="1", xlabel="", labeldistance=1.6];
Sala -> Asiento [dir=both, arrowtail=diamond, arrowhead=none, headlabel="1..*", taillabel="1", xlabel="", labeldistance=1.6];
Compra -> Entrada [dir=both, arrowtail=diamond, arrowhead=none, headlabel="0..10", taillabel="1", xlabel="", labeldistance=1.6];
Compra -> LineaConfiteria [dir=both, arrowtail=diamond, arrowhead=none, headlabel="0..*", taillabel="1", xlabel="", labeldistance=1.6];
Compra -> Reembolso [dir=both, arrowtail=diamond, arrowhead=none, headlabel="0..1", taillabel="1", xlabel="", labeldistance=1.6];
Cliente -> Compra [dir=both, arrowtail=odiamond, arrowhead=none, headlabel="0..*", taillabel="1", xlabel="historial", labeldistance=1.6];
Combo -> Producto [dir=both, arrowtail=odiamond, arrowhead=none, headlabel="2..*", taillabel="0..*", xlabel="", labeldistance=1.6];
SolicitudRecarga -> Cliente [arrowhead=vee, headlabel="1", taillabel="0..*", xlabel="solicita", labeldistance=1.6];
Funcion -> Pelicula [arrowhead=vee, headlabel="1", taillabel="0..*", xlabel="", labeldistance=1.6];
Funcion -> Sala [arrowhead=vee, headlabel="1", taillabel="0..*", xlabel="", labeldistance=1.6];
Funcion -> Asiento [arrowhead=vee, headlabel="0..*", taillabel="", xlabel="ocupados", labeldistance=1.6];
Compra -> Funcion [arrowhead=vee, headlabel="1", taillabel="0..*", xlabel="", labeldistance=1.6];
Entrada -> Asiento [arrowhead=vee, headlabel="1", taillabel="0..*", xlabel="", labeldistance=1.6];
Entrada -> Funcion [arrowhead=vee, headlabel="1", taillabel="0..*", xlabel="", labeldistance=1.6];
LineaConfiteria -> ItemConfiteria [arrowhead=vee, headlabel="1", taillabel="0..*", xlabel="", labeldistance=1.6];
n1 [shape=note, style=filled, fillcolor="#fff8dc", fontsize=9, label="Identificable también la implementan:\nPelicula, Sala, Funcion, Entrada, Compra,\nReembolso, Movimiento, SolicitudRecarga,\nPromocion e ItemConfiteria."];
n1 -> Identificable [style=dotted, arrowhead=none];
n2 [shape=note, style=filled, fillcolor="#fff8dc", fontsize=9, label="Azul: clases que participan en patrones\ncreacionales (Prototype en Funcion,\nFactory Method crea Entrada,\nBuilder construye Compra)."];
}