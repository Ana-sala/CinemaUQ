digraph G {
graph [fontname="Helvetica", fontsize=20, labelloc=t, label="Builder · CompraBuilder", rankdir=LR, nodesep=0.6, ranksep=1.6, splines=spline, newrank=true, pad=0.4];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#3b4252"];
Ctrl [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«Director / cliente»</FONT><BR/><B>ClienteController</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-construirCompra(): CompraBuilder<BR/>-onComprar()</TD></TR></TABLE>>];
Serv [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>ServicioCompras</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+nuevaCompra(cliente, funcion): CompraBuilder<BR/>+pagar(compra): Compra</TD></TR></TABLE>>];
B [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><FONT POINT-SIZE="9">«Builder»</FONT><BR/><B>CompraBuilder</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-cliente<BR/>-funcion<BR/>-entradas: List&lt;Entrada&gt;<BR/>-lineas: List&lt;LineaConfiteria&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+agregarEntrada(a): CompraBuilder<BR/>+agregarEntradaConPuntos(a): CompraBuilder<BR/>+agregarConfiteria(item, n): CompraBuilder<BR/>+agregarConfiteriaConPuntos(item, n): CompraBuilder<BR/>+getValorAPagar(): double<BR/>+getPuntosNecesarios(): int<BR/>+build(): Compra</TD></TR></TABLE>>];
C [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«Product»</FONT><BR/><B>Compra</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-entradas<BR/>-lineas<BR/>-puntosRedimidos<BR/>-estado = PENDIENTE</TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
Ctrl -> Serv [arrowhead=vee, style=dashed, xlabel="1. nuevaCompra()"];
Serv -> B [arrowhead=vee, style=dashed, xlabel="«create»"];
Ctrl -> B [arrowhead=vee, style=dashed, xlabel="2. agregar...()  3. build()"];
B -> C [arrowhead=vee, style=dashed, xlabel="«create»"];
}