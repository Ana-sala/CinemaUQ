digraph G {
graph [fontname="Helvetica", fontsize=20, labelloc=t, label="Factory Method · FabricaEntrada", rankdir=TB, nodesep=0.5, ranksep=0.7, splines=ortho, newrank=true, pad=0.4];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#3b4252"];
Builder [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«Cliente del patrón»</FONT><BR/><B>CompraBuilder</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+agregarEntrada(a: Asiento)</TD></TR></TABLE>>];
Catalogo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>CatalogoFabricasEntrada</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fabricas: Map&lt;TipoAsiento, FabricaEntrada&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+emitir(f, a): Entrada<BR/>+registrar(tipo, fabrica)</TD></TR></TABLE>>];
FE [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><FONT POINT-SIZE="9">«Creator»</FONT><BR/><I><B>FabricaEntrada</B></I></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+emitir(f, a): Entrada<BR/><I>#crearEntrada(id, f, a): Entrada</I></TD></TR></TABLE>>];
FG [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><FONT POINT-SIZE="9">«ConcreteCreator»</FONT><BR/><B>FabricaEntradaGeneral</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#crearEntrada(id, f, a): Entrada</TD></TR></TABLE>>];
FP [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><FONT POINT-SIZE="9">«ConcreteCreator»</FONT><BR/><B>FabricaEntradaPreferencial</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#crearEntrada(id, f, a): Entrada</TD></TR></TABLE>>];
E [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«Product»</FONT><BR/><I><B>Entrada</B></I></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+getPrecio(): double</I></TD></TR></TABLE>>];
EG [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«ConcreteProduct»</FONT><BR/><B>EntradaGeneral</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getPrecio() = precio base</TD></TR></TABLE>>];
EP [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«ConcreteProduct»</FONT><BR/><B>EntradaPreferencial</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getPrecio() = base × 1,30</TD></TR></TABLE>>];
Builder -> Catalogo [arrowhead=vee, headlabel="1", taillabel="", xlabel="", labeldistance=1.6];
Catalogo -> FE [dir=both, arrowtail=odiamond, arrowhead=none, headlabel="1..*", taillabel="", xlabel="", labeldistance=1.6];
FE -> FG [dir=back, arrowtail=onormal, arrowsize=1.3];
FE -> FP [dir=back, arrowtail=onormal, arrowsize=1.3];
E -> EG [dir=back, arrowtail=onormal, arrowsize=1.3];
E -> EP [dir=back, arrowtail=onormal, arrowsize=1.3];
FG -> EG [arrowhead=vee, style=dashed, xlabel="«create»"];
FP -> EP [arrowhead=vee, style=dashed, xlabel="«create»"];
FE -> E [arrowhead=vee, style=dashed, xlabel="devuelve"];
}