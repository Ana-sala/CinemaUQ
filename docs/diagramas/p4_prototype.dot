digraph G {
graph [fontname="Helvetica", fontsize=20, labelloc=t, label="Prototype · Funcion", rankdir=LR, nodesep=0.6, ranksep=1.6, splines=spline, newrank=true, pad=0.4];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#3b4252"];
Adm [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>AdminController</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-onDuplicarFuncion()</TD></TR></TABLE>>];
SC [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«Cliente del patrón»</FONT><BR/><B>ServicioCartelera</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+duplicarFuncion(original, fecha): Funcion<BR/>-guardarFuncion(f): valida cruces</TD></TR></TABLE>>];
P [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Prototipo&lt;T&gt;</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+clonar(): T</I></TD></TR></TABLE>>];
F [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f2a44"><TR><TD BGCOLOR="#e8f0fe" ALIGN="CENTER"><FONT POINT-SIZE="9">«ConcretePrototype»</FONT><BR/><B>Funcion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-pelicula<BR/>-sala<BR/>-fechaHora<BR/>-precioBase<BR/>-ocupados: Set&lt;Asiento&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+clonar(): Funcion<BR/>+clonarPara(fecha): Funcion</TD></TR></TABLE>>];
Adm -> SC [arrowhead=vee, style=dashed, xlabel="duplicarFuncion()"];
SC -> F [arrowhead=vee, style=dashed, xlabel="original.clonarPara(fecha)"];
P -> F [dir=back, arrowtail=onormal, style=dashed, arrowsize=1.3];
np [shape=note, style=filled, fillcolor="#fff8dc", fontsize=9, label="La copia conserva película, sala y precio;\nrecibe id nuevo, la nueva fecha,\nestado PROGRAMADA y ninguna silla vendida."];
np -> F [style=dotted, arrowhead=none];
}